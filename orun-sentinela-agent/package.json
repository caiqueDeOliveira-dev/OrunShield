{
  "name": "@orun/sentinela-agent",
  "version": "0.1.0",
  "description": "Agente de IA do Hampton que traduz achados técnicos do Orun Shield em explicações claras para o usuário, com providers de IA plugáveis (local e cloud).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
