    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orun/shield-core": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
