{
  "name": "orun-shield-app",
  "productName": "Orun Shield",
  "version": "0.1.0",
  "description": "Orun Shield standalone — Antivírus + Otimizador em um app só.",
  "main": "electron/main.cjs",
  "author": "Orun",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:electron": "wait-on tcp:127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "typecheck": "tsc --noEmit -p renderer/tsconfig.json",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:renderer && npm run typecheck",
    "start": "electron .",
    "stage:clamav": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-clamav.ps1",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "@orun/shield-core": "file:vendor/orun-shield-core",
    "@orun/system-optimizer": "file:vendor/orun-system-optimizer",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "node-fetch": "2.7.0"
  },
  "build": {
    "appId": "br.com.orun.shield",
    "productName": "Orun Shield",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**",
      "renderer/dist/**",
      "rules/**",
      "scripts/stage-clamav.ps1"
    ],
    "extraResources": [
      {
        "from": "resources/clamav",
        "to": "clamav"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.25.12": true
  }
}
