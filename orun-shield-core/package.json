    "node-fetch": "^3.3.2",
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
