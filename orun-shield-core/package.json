{
  "name": "@orun/shield-core",
  "version": "0.1.0",
  "description": "Suite de segurança desktop do Orun OS: detecção de malware, monitoramento comportamental, firewall e integridade de sistema.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
