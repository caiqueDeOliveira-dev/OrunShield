{
  "name": "@orun/system-optimizer",
  "version": "0.1.0",
  "description": "Análise de uso de disco, limpeza segura de arquivos desnecessários e verificação/atualização de software desatualizado para o Orun OS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=18"
  }
}
